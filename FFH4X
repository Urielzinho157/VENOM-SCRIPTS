local function GetESP(p)
    if not ESPObjects[p] then
        local d={}
        d.Box={}; for i=1,4 do local l=Drawing.new("Line"); l.Color=N.espBox; l.Thickness=1.7; l.Visible=false; d.Box[i]=l end
        d.Skel={}; for i=1,#BONES do local l=Drawing.new("Line"); l.Color=N.espSkel; l.Thickness=1.1; l.Visible=false; d.Skel[i]=l end
        d.HBg=Drawing.new("Line"); d.HBg.Color=Color3.fromRGB(18,2,2); d.HBg.Thickness=4; d.HBg.Visible=false
        d.HFill=Drawing.new("Line"); d.HFill.Thickness=3; d.HFill.Visible=false
        d.Name=Drawing.new("Text"); d.Name.Color=N.espName; d.Name.Size=13; d.Name.Font=Drawing.Fonts.UI; d.Name.Outline=true; d.Name.Visible=false
        d.Line=Drawing.new("Line"); d.Line.Color=N.espLine; d.Line.Thickness=1; d.Line.Visible=false
        ESPObjects[p]=d
    end
    return ESPObjects[p]
end
local function ClearESP(p)
    local d=ESPObjects[p]; if not d then return end
    for _,l in pairs(d.Box) do l.Visible=false end
