--  RENDER LOOP
-- ══════════════════════════════════════════
local stickyTarget=nil

RunService.RenderStepped:Connect(function()
    if not CFG.Unlocked then return end
    local cx=Camera.ViewportSize.X/2
    local cy=Camera.ViewportSize.Y/2

    FOVRing.Visible=CFG.AimbotEnabled
    FOVRing.Radius=170; FOVRing.Position=Vector2.new(cx,cy)

    if CFG.AimbotEnabled then
        local nearest=getNearestTarget()
        if nearest then stickyTarget=nearest end
        local target=stickyTarget
        if target and isAlive(target) then
            local bone=getBone(target,CFG.AimbotBone)
            if bone then
                local factor
                if CFG.AuxMode then
                    -- auxílio: factor muito suave, parece natural
                    factor=math.clamp(1-(CFG.AimbotSmooth/31)*0.5,0.01,0.12)
                elseif CFG.AimLegit then
                    factor=math.clamp(1-(CFG.AimbotSmooth/31)*0.85,0.03,0.30)
                else
                    factor=math.clamp(1-(CFG.AimbotSmooth/31),0.05,0.97)
                end
                local aimCF=CFrame.new(Camera.CFrame.Position,bone.Position)
                Camera.CFrame=Camera.CFrame:Lerp(aimCF,factor)
            end
        else stickyTarget=nil end
    end

    if LP.Character then
        local hum=LP.Character:FindFirstChildOfClass("Humanoid")
        local hrp=LP.Character:FindFirstChild("HumanoidRootPart")
        if hum then
            if CFG.SpeedValue<=SAFE_CAP then
                hum.WalkSpeed=CFG.SpeedValue; removeBV()
            else
                hum.WalkSpeed=SAFE_CAP
                local bv=getOrMakeBV()
                if bv and hrp then
                    local md=hum.MoveDirection
                    bv.Velocity=md.Magnitude>0.1 and md*(CFG.SpeedValue-SAFE_CAP) or Vector3.new(0,0,0)
                end
            end
        end
    end

    for _,p in pairs(Players:GetPlayers()) do
        if p==LP then continue end
        local char=getChar(p); local hum=getHum(p); local root=getRoot(p); local d=GetESP(p)
        if not CFG.ESPEnabled or not char or not root or not isAlive(p) then ClearESP(p); continue end
        local rSP,rVis=Camera:WorldToViewportPoint(root.Position)
        if not rVis then ClearESP(p); continue end

        if CFG.ESPName then d.Name.Text=p.Name; d.Name.Position=Vector2.new(rSP.X,rSP.Y-56); d.Name.Visible=true
        else d.Name.Visible=false end

        if CFG.ESPLine then
            d.Line.From=Vector2.new(cx,Camera.ViewportSize.Y)
            d.Line.To=Vector2.new(rSP.X,rSP.Y); d.Line.Visible=true
        else d.Line.Visible=false end

        local head=char:FindFirstChild("Head")
        local x1,y1,x2,y2
        if head then
            local tSP=Camera:WorldToViewportPoint(head.Position+Vector3.new(0,0.7,0))
            local bSP=Camera:WorldToViewportPoint(root.Position-Vector3.new(0,2.8,0))
            local w=math.abs(tSP.X-bSP.X)*1.6+30
            x1=rSP.X-w/2; y1=tSP.Y; x2=rSP.X+w/2; y2=bSP.Y
