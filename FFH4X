local touches={}

local function showPanel()
    if not CFG.Unlocked then return end
    CFG.PanelVisible=true
    Panel.Visible=true; PGlow.Transparency=1
    Panel.BackgroundTransparency=1
    TweenService:Create(Panel,TweenInfo.new(0.2,Enum.EasingStyle.Quad),{BackgroundTransparency=0.02}):Play()
    TweenService:Create(PGlow,TweenInfo.new(0.2),{Transparency=0}):Play()
    setMin(false)
end
local function hidePanel()
    CFG.PanelVisible=false
    TweenService:Create(Panel,TweenInfo.new(0.17,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
    TweenService:Create(PGlow,TweenInfo.new(0.17),{Transparency=1}):Play()
    task.delay(0.19,function() Panel.Visible=false end)
end

UserInputService.TouchStarted:Connect(function(touch,gpe)
    touches[touch]=true
    local n=0; for _ in pairs(touches) do n=n+1 end
    if n>=2 then
        table.clear(touches)
        if CFG.PanelVisible then hidePanel() else showPanel() end
    end
end)
UserInputService.TouchEnded:Connect(function(t) touches[t]=nil end)
UserInputService.InputBegan:Connect(function(inp,gpe)
    if gpe then return end
    if inp.KeyCode==Enum.KeyCode.Insert then
        if CFG.PanelVisible then hidePanel() else showPanel() end
    end
end)

