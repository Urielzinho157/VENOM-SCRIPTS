local function SliderPreset(parent,label,cfgKey,presets,minV,maxV,step,cb)
    step=step or 1
    local LblF=Instance.new("Frame",parent)
    LblF.Size=UDim2.new(1,0,0,20); LblF.BackgroundTransparency=1
    local LV=Instance.new("TextLabel",LblF)
    LV.Text=label..":  "..tostring(CFG[cfgKey]); LV.Font=Enum.Font.GothamBold; LV.TextSize=11
    LV.TextColor3=N.txt; LV.BackgroundTransparency=1
    LV.Size=UDim2.new(1,0,1,0); LV.Position=UDim2.new(0,12,0,0)
    LV.TextXAlignment=Enum.TextXAlignment.Left

    local BtnF=Instance.new("Frame",parent)
    BtnF.Size=UDim2.new(1,0,0,34); BtnF.BackgroundTransparency=1
    local BLL=Instance.new("UIListLayout",BtnF)
    BLL.FillDirection=Enum.FillDirection.Horizontal; BLL.Padding=UDim.new(0,6)
    Instance.new("UIPadding",BtnF).PaddingLeft=UDim.new(0,12)

    local function refresh(val)
        LV.Text=label..":  "..tostring(val)
        for _,ch in ipairs(BtnF:GetChildren()) do
            if ch:IsA("TextButton") then
                local isThis=tonumber(ch.Text)==val
                TweenService:Create(ch,TweenInfo.new(0.1),{BackgroundColor3=isThis and N.neonDark or N.btn}):Play()
                ch.TextColor3=isThis and N.neon or N.dim
                for _,s in ipairs(ch:GetChildren()) do
                    if s:IsA("UIStroke") then s.Transparency=isThis and 0 or 0.7 end
                end
            end
        end
    end

    for _,val in ipairs(presets) do
        local PBtn=Instance.new("TextButton",BtnF)
        PBtn.Text=tostring(val); PBtn.Font=Enum.Font.GothamBold; PBtn.TextSize=12
        PBtn.TextColor3=CFG[cfgKey]==val and N.neon or N.dim
        PBtn.BackgroundColor3=CFG[cfgKey]==val and N.neonDark or N.btn
        PBtn.AutoButtonColor=false; PBtn.Size=UDim2.new(0,62,0,30)
        Instance.new("UICorner",PBtn).CornerRadius=UDim.new(0,7)
        Glow(PBtn,N.neon,1.2,CFG[cfgKey]==val and 0 or 0.7)
        PBtn.MouseButton1Click:Connect(function() CFG[cfgKey]=val; refresh(val); if cb then pcall(cb,val) end end)
    end

    local TrackF=Instance.new("Frame",parent)
    TrackF.Size=UDim2.new(1,0,0,22); TrackF.BackgroundTransparency=1
    local Track=Instance.new("Frame",TrackF)
    Track.Size=UDim2.new(1,-24,0,8); Track.Position=UDim2.new(0,12,0.5,-4)
    Track.BackgroundColor3=N.track; Track.BorderSizePixel=0
    Instance.new("UICorner",Track).CornerRadius=UDim.new(1,0)
    local r0=(CFG[cfgKey]-minV)/(maxV-minV)
    local Fill=Instance.new("Frame",Track)
    Fill.Size=UDim2.new(r0,0,1,0); Fill.BackgroundColor3=N.neon; Fill.BorderSizePixel=0
    Instance.new("UICorner",Fill).CornerRadius=UDim.new(1,0)
    Glow(Fill,N.neon,1,0.3)
    local Dot=Instance.new("Frame",Track)
    Dot.Size=UDim2.new(0,18,0,18); Dot.Position=UDim2.new(r0,-9,0.5,-9)
    Dot.BackgroundColor3=N.neonSoft; Dot.BorderSizePixel=0
    Instance.new("UICorner",Dot).CornerRadius=UDim.new(1,0)
    Glow(Dot,N.neon,1.4,0.1)
    local DA=Instance.new("TextButton",TrackF)
    DA.Size=UDim2.new(1,0,1,0); DA.BackgroundTransparency=1; DA.Text=""; DA.ZIndex=10
    local dragging=false
    local function applyX(absX)
        local tX=Track.AbsolutePosition.X; local tW=Track.AbsoluteSize.X
        if tW<=0 then return end
        local rel=math.clamp((absX-tX)/tW,0,1)
        local val=math.clamp(math.round((minV+rel*(maxV-minV))/step)*step,minV,maxV)
        CFG[cfgKey]=val; local nr=(val-minV)/(maxV-minV)
        Fill.Size=UDim2.new(nr,0,1,0); Dot.Position=UDim2.new(nr,-9,0.5,-9)
        refresh(val); if cb then pcall(cb,val) end
    end
    DA.MouseButton1Down:Connect(function(x) dragging=true; applyX(x) end)
    DA.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then dragging=true; applyX(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then applyX(i.Position.X) end
    end)
end

