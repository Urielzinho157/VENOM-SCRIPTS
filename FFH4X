-- lista de Keys revogadas pelo JV
local REVOKED_KEYS = {}
-- usuários ativos: key → username
local ACTIVE_USERS = {}

local function revokeKey(key)
    REVOKED_KEYS[key] = true
    ACTIVE_USERS[key] = nil
    print("[FFH4X] Key revogada: " .. tostring(key))
end

local function validateKey(key, username)
    if REVOKED_KEYS[key] then
        return false, "KEY REVOGADA"
    end
    if not VALID_KEYS[key] then
        return false, "KEY INVÁLIDA"
    end
    -- registra usuário ativo
    ACTIVE_USERS[key] = username or "desconhecido"
    VALID_KEYS[key].owner = username or "desconhecido"
    return true, VALID_KEYS[key].days
end

