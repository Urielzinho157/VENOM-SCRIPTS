local function getOrMakeBV()
    if not LP.Character then return nil end
    local hrp=LP.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
    local ex=hrp:FindFirstChild("FH_BV"); if ex then return ex end
    local bv=Instance.new("BodyVelocity")
    bv.Name="FH_BV"; bv.MaxForce=Vector3.new(1e5,0,1e5); bv.Velocity=Vector3.new(0,0,0); bv.Parent=hrp
    return bv
end
local function removeBV()
    if not LP.Character then return end
    local hrp=LP.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local bv=hrp:FindFirstChild("FH_BV"); if bv then bv:Destroy() end
end

