-- ══════════════════════════════════════════
--  HELPERS
-- ══════════════════════════════════════════
local function getChar(p)   return p and p.Character end
local function getHum(p)    local c=getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot(p)   local c=getChar(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function getBone(p,b) local c=getChar(p) return c and (c:FindFirstChild(b) or c:FindFirstChild("HumanoidRootPart")) end
local function isAlive(p)   local h=getHum(p)  return h and h.Health>0 end
local function sameTeam(p)  return p.Team and LP.Team and p.Team==LP.Team end

local function getTargets()
    local t={}
    for _,p in pairs(Players:GetPlayers()) do
        if p==LP then continue end
        if CFG.IgnoreDead and not isAlive(p) then continue end
        if CFG.IgnoreTeam and sameTeam(p)    then continue end
        if getRoot(p) then table.insert(t,p) end
    end
    return t
end

local function getNearestTarget()
    local best,bestDist=nil,math.huge
    local cx=Camera.ViewportSize.X/2
    local cy=Camera.ViewportSize.Y/2
    for _,p in pairs(getTargets()) do
        local bone=getBone(p,CFG.AimbotBone)
        if bone then
            local sp,vis=Camera:WorldToViewportPoint(bone.Position)
            if vis then
                local d=(Vector2.new(sp.X,sp.Y)-Vector2.new(cx,cy)).Magnitude
                if d<bestDist then best,bestDist=p,d end
            end
        end
    end
    return best
end

